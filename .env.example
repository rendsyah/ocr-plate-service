# App Settings
APP_NAME=ocr-plate-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=DEBUG

# OCR Settings
OCR_ENGINE=paddleocr
OCR_DETECTION_MODEL=PP-OCRv6_small_det
OCR_RECOGNITION_MODEL=PP-OCRv6_small_rec
NORMALIZER_COUNTRY=indonesia
MIN_OCR_CONFIDENCE=0.5

# Inference Settings
DETECTOR_TYPE=yolo
PLATE_MODEL_PATH=models/license_plate.pt
VEHICLE_MODEL_PATH=models/vehicle.pt
MIN_DETECTION_CONFIDENCE=0.5

# Storage Settings
SAVE_SNAPSHOTS=true
SNAPSHOT_DIR=storage/snapshots
DEBUG_DIR=storage/debug
