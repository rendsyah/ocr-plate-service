# App Settings
APP_NAME=ocr-plate-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=DEBUG

# OCR Settings
OCR_ENGINE=paddleocr
OCR_USE_GPU=false
OCR_DETECTION_MODEL=PP-OCRv6_small_det
OCR_RECOGNITION_MODEL=PP-OCRv6_small_rec
NORMALIZER_COUNTRY=indonesia
MIN_OCR_CONFIDENCE=0.5

# Inference Settings
DETECTOR_TYPE=yolo
DETECTOR_MODEL_PATH=models/license_plate.pt
DETECTOR_USE_GPU=false
MIN_DETECTION_CONFIDENCE=0.5

# Camera Settings
CAMERA_TYPE=snapshot
CAMERA_SOURCE=http://192.168.1.100/snapshot.jpg
CAMERA_TIMEOUT=5.0
CAMERA_RETRIES=3

# Storage Settings
SAVE_SNAPSHOTS=true
SNAPSHOT_DIR=storage/snapshots
DEBUG_DIR=storage/debug
RETENTION_DAYS=7
